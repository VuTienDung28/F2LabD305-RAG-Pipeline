# OpenRouter API Key (Khuyên dùng cho bài lab - có model free :free)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API Key (Tùy chọn - fallback nếu OpenRouter bị 429 rate limit)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...

# EMBEDDING_PROVIDER=sentence_transformers  # Mặc định (local, nặng ~1-2GB do kéo theo torch)
# EMBEDDING_PROVIDER=google                 # Nhẹ, cần GEMINI_API_KEY, dimension 768
# EMBEDDING_PROVIDER=openai                 # Nhẹ, cần OPENAI_API_KEY, dimension 1536
# Lưu ý: đổi provider phải xoá chroma_db/ cũ và chạy lại Task 4 (dimension khác nhau, không tương thích ngược)
